NODE_ENV=development
PORT=3003

# Public URL of the MCP endpoint. It is the RFC 8707 resource: access tokens must carry it as `aud`.
MCP_RESOURCE_URL=http://localhost:3003/mcp

# Authorization Server (issuer of the tokens agents present). Metadata is discovered via RFC 8414.
AUTH_ISSUER=http://localhost:9000
# Optional: skip JWKS discovery
AUTH_JWKS_URI=
AUTH_ALLOWED_ALGORITHMS=RS256,ES256
AUTH_CLOCK_TOLERANCE_SEC=30
AUTH_REQUIRE_AT_JWT_TYP=false
AUTH_SCOPES_SUPPORTED="cosmic:read spreads:read spreads:write"
# Local development only; refused when NODE_ENV=production
AUTH_ALLOW_INSECURE_ISSUER=true

# This server's own OAuth client at the Authorization Server, used for RFC 8693 token exchange (OBO).
TOKEN_EXCHANGE_CLIENT_ID=mcp-service-api
# client_secret_basic is refused when NODE_ENV=production
TOKEN_EXCHANGE_AUTH_METHOD=client_secret_basic
TOKEN_EXCHANGE_CLIENT_SECRET=change-me-dev-secret-0000
# For private_key_jwt: PKCS#8 PEM (newlines may be written as \n)
TOKEN_EXCHANGE_PRIVATE_KEY=
TOKEN_EXCHANGE_PRIVATE_KEY_ALG=ES256
TOKEN_EXCHANGE_PRIVATE_KEY_ID=
TOKEN_EXCHANGE_TIMEOUT_MS=5000
TOKEN_EXCHANGE_EXPIRY_SKEW_SEC=30
TOKEN_EXCHANGE_MAX_CACHE_ENTRIES=10000

# Downstream: nasa-service-api (TCP). Exchanged tokens are minted for this resource and scopes.
NASA_SERVICE_HOST=127.0.0.1
NASA_SERVICE_PORT=4002
NASA_SERVICE_TIMEOUT_MS=10000
NASA_SERVICE_RESOURCE=urn:cosmic-arcana:nasa-service
NASA_SERVICE_SCOPES=cosmic:read
